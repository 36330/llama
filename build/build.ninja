  FLAGS = -O3 -DNDEBUG
  LINK_LIBRARIES = -Wl,-rpath,/home/ljl/ljl_test/llama/build/bin:  common/libcommon.a  bin/libllama.so.0.0.8163  bin/libggml.so.0.9.7  bin/libggml-cpu.so.0.9.7  bin/libggml-vulkan.so.0.9.7  bin/libggml-base.so.0.9.7  vendor/cpp-httplib/libcpp-httplib.a  /usr/lib/x86_64-linux-gnu/libssl.so  /usr/lib/x86_64-linux-gnu/libcrypto.so
  OBJECT_DIR = tools/results/CMakeFiles/llama-results.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = tools/results/CMakeFiles/llama-results.dir/
  TARGET_FILE = bin/llama-results
  TARGET_PDB = bin/llama-results.pdb


