  COMMAND = cd /home/ljl/ljl_test/llama/build/tools/tts && /usr/bin/cmake --regenerate-during-build -S/home/ljl/ljl_test/llama -B/home/ljl/ljl_test/llama/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build tools/tts/rebuild_cache: phony tools/tts/CMakeFiles/rebuild_cache.util


#############################################
