build tools/results/CMakeFiles/llama-results.dir/results.cpp.o: CXX_COMPILER__llama-results_unscanned_Release /home/ljl/ljl_test/llama/tools/results/results.cpp || cmake_object_order_depends_target_llama-results
  DEFINES = -DGGML_BACKEND_SHARED -DGGML_SHARED -DGGML_USE_CPU -DGGML_USE_VULKAN -DLLAMA_SHARED
  DEP_FILE = tools/results/CMakeFiles/llama-results.dir/results.cpp.o.d
  FLAGS = -O3 -DNDEBUG -Wmissing-declarations -Wmissing-noreturn -Wall -Wextra -Wpedantic -Wcast-qual -Wno-unused-function -Wno-array-bounds -Wextra-semi
  INCLUDES = -I/home/ljl/ljl_test/llama/common/. -I/home/ljl/ljl_test/llama/common/../vendor -I/home/ljl/ljl_test/llama/src/../include -I/home/ljl/ljl_test/llama/ggml/src/../include
  OBJECT_DIR = tools/results/CMakeFiles/llama-results.dir
  OBJECT_FILE_DIR = tools/results/CMakeFiles/llama-results.dir
  TARGET_COMPILE_PDB = tools/results/CMakeFiles/llama-results.dir/
  TARGET_PDB = bin/llama-results.pdb


